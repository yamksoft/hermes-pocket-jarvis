# Hermes must run on the same device as this bridge/worker.
HERMES_API_BASE=http://127.0.0.1:8642
API_SERVER_KEY=replace-with-your-Hermes-API_SERVER_KEY
HERMES_PROFILE=default

# Keep 127.0.0.1 on phones and personal computers. Do not expose Hermes publicly.
JARVIS_BIND_HOST=127.0.0.1
JARVIS_PORT=8787

# LiveKit Cloud: create these in the LiveKit Cloud project. Keep the secret server-side.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=hermes-jarvis
# Optional: set this only for a non-production LiveKit agent deployment.
LIVEKIT_AGENT_DEPLOYMENT=

# Google AI Studio key. Used only by the Python LiveKit worker, never browser JS.
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Puck
JARVIS_LANGUAGE=ar
HERMES_RUN_TIMEOUT_SECONDS=120
